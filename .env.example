# =========================================================
# Root environment for docker-compose (copy to .env)
# Example values only - NEVER commit real secrets.
# =========================================================

# --- PostgreSQL superuser (only used for bootstrapping) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_HOST_PORT=5433

# --- Auth service database (owned by auth-service only) ---
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth

# --- Repairs service database (owned by repairs-service only) ---
REPAIRS_DB_NAME=repairs_db
REPAIRS_DB_USER=repairs_user
REPAIRS_DB_PASSWORD=change_me_repairs

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin
PGADMIN_HOST_PORT=5050

# --- Auth service (Express + TypeScript) ---
CORS_ORIGINS=http://localhost:5173
AUTH_SERVICE_HOST_PORT=3001
JWT_ISSUER=mining-repairs-auth
JWT_AUDIENCE=mining-repairs-api

# --- Repairs service (FastAPI) ---
REPAIRS_SERVICE_HOST_PORT=8000

# --- Bootstrap admin for docker-compose (optional, idempotent) ---
# Creates the first admin on startup when no admin exists yet.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@mining-repairs.local
SEED_ADMIN_PASSWORD=ChangeMe123

# --- Frontend (React, served by nginx) ---
FRONTEND_HOST_PORT=5173
