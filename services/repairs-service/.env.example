# =========================================================
# Repairs service - copy to .env and adjust for your environment
# NEVER commit real secrets.
# =========================================================

REPAIRS_ENVIRONMENT=development
REPAIRS_LOG_SQL=false

# Comma separated list of allowed browser origins
REPAIRS_CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (repairs_db is owned exclusively by this service) ---
REPAIRS_DATABASE_URL=postgresql+psycopg://repairs_user:change_me_repairs@localhost:5433/repairs_db

# --- JWT validation (only the PUBLIC key; tokens are issued by the auth service) ---
REPAIRS_JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
REPAIRS_JWT_ALGORITHM=RS256
REPAIRS_JWT_ISSUER=mining-repairs-auth
REPAIRS_JWT_AUDIENCE=mining-repairs-api

# --- Tests (optional, defaults to repairs_db_test on localhost:5433) ---
# REPAIRS_TEST_DATABASE_URL=postgresql+psycopg://repairs_user:change_me_repairs@localhost:5433/repairs_db_test
