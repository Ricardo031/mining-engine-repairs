# =========================================================
# Auth service - copy to .env and adjust for your environment
# NEVER commit real secrets.
# =========================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (auth_db is owned exclusively by this service) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=change_me_auth
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# --- JWT (RS256: this service signs with the private key) ---
# Paths are resolved from the service working directory.
JWT_PRIVATE_KEY_PATH=../../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
JWT_ISSUER=mining-repairs-auth
JWT_AUDIENCE=mining-repairs-api
JWT_EXPIRES_IN_SECONDS=3600

# --- Password hashing ---
BCRYPT_ROUNDS=12

# --- Bootstrap admin (idempotent, only runs when no admin exists) ---
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@mining-repairs.local
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
